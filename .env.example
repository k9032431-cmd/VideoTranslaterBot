# ── Обязательно ──────────────────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=
# Ключ OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Доступ ───────────────────────────────────────────────────────────────────
# Кто может пользоваться ботом (Telegram user id через запятую). Пусто = все.
# Перевод стоит денег, поэтому лучше ограничить. Свой id можно узнать у @userinfobot.
ALLOWED_USER_IDS=

# ── Модели ───────────────────────────────────────────────────────────────────
TRANSCRIBE_MODEL=whisper-1
TRANSLATE_MODEL=gpt-5.4
TTS_MODEL=gpt-4o-mini-tts
# alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar, fable, onyx, nova
TTS_VOICE=onyx

# ── Ограничения ──────────────────────────────────────────────────────────────
MAX_VIDEO_MINUTES=180
MAX_CONCURRENT_JOBS=2
# Громкость оригинальной дорожки под озвучкой (0..1)
ORIGINAL_VOLUME=0.15

# ── Большие файлы (до 2 ГБ) ──────────────────────────────────────────────────
# Без локального сервера Telegram бот принимает файлы до 20 МБ и отправляет до 50 МБ.
# Чтобы снять ограничение: получите api_id / api_hash на https://my.telegram.org,
# заполните их и запустите `docker compose --profile bigfiles up -d`.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Для профиля bigfiles раскомментируйте:
# TELEGRAM_API_URL=http://telegram-bot-api:8081
