# ── Обязательно ──────────────────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=

# Режим: free — бесплатно (Groq + голоса Microsoft), openai — платно через OpenAI
PROVIDER=free
# Для PROVIDER=free: бесплатный ключ https://console.groq.com/keys
GROQ_API_KEY=
# Для PROVIDER=openai: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Доступ ───────────────────────────────────────────────────────────────────
# Кто может пользоваться ботом (Telegram user id через запятую). Пусто = все.
# Свой id можно узнать у @userinfobot.
ALLOWED_USER_IDS=

# ── Озвучка ──────────────────────────────────────────────────────────────────
# Голос для бесплатного режима: male или female
TTS_GENDER=male
# Голос для OpenAI: alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar, fable, onyx, nova
TTS_VOICE=onyx

# ── Модели (пусто = по умолчанию для выбранного режима) ──────────────────────
# free:   whisper-large-v3 / openai/gpt-oss-120b
# openai: whisper-1 / gpt-5.4 / gpt-4o-mini-tts
TRANSCRIBE_MODEL=
TRANSLATE_MODEL=
TTS_MODEL=

# ── Ограничения ──────────────────────────────────────────────────────────────
MAX_VIDEO_MINUTES=180
MAX_CONCURRENT_JOBS=2
# Громкость оригинальной дорожки под озвучкой (0..1)
ORIGINAL_VOLUME=0.15

# ── Большие файлы (до 2 ГБ) ──────────────────────────────────────────────────
# Проще всего включить командой `vtbot bigfiles`.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# TELEGRAM_API_URL=http://127.0.0.1:8081
